{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Go backend",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Debug Angular in Chrome",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "frontend: serve (Angular :4200)",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (Go + Angular)",
      "configurations": ["Debug Go backend", "Debug Angular in Chrome"],
      "stopAll": true
    }
  ]
}
