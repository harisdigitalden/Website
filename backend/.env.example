# Copy this file to .env (same folder) and fill in your email details.
# .env is ignored by git, so your password never goes to GitHub.
# On Render, set the same names under Service -> Environment instead.

# Gmail / Google Workspace: smtp.gmail.com   Zoho Mail: smtp.zoho.in
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Your full email address
SMTP_USER=you@example.com

# Gmail: an App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_PASS=

# Where consultation forms should arrive (comma-separate several)
NOTIFY_TO=you@example.com
